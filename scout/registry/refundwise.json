          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "reason_type": {
            "enum": [
              "not_received"
            ],
            "default": "not_received"
          }
        }
      },
      "x-bind": {
        "order_id": {
          "regex": "\\b(ORD-\\d{3,})\\b",
          "upper": true
        }
      },
      "triggers": [
        {
          "phrase": "never arrived",
          "weight": 0.9
        },
        {
          "phrase": "hasnt arrived",
          "weight": 0.9
