        },
        {
          "phrase": "lost package",
          "weight": 0.7
        },
        {
          "phrase": "missing",
          "weight": 0.4
        }
      ],
      "negativeTriggers": [
        "track"
      ],
      "capabilities": [
        "order.lookup",
        "refund.history",
        "policy.lookup",
        "policy.check",
        "agent.review",
        "reply.compose"
      ],
      "riskClass": "medium",
      "surfaces": [
        "chat",
        "email",
        "api"
      ],
      "roles": [
        "customer",
        "support-agent",
        "admin"
      ],
      "examples": [
        "My order ORD-2004 never arrived",
        "It has been three weeks and ORD-2005 still hasn't arrived",
        "I didn't receive my parcel for ORD-2006"
