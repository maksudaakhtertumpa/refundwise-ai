{
  "version": 1,
  "note": "RefundWise AI intent registry: the complete surface area the support agent may act on. Anything outside it falls back to GENERAL.",
  "intents": [
    {
      "id": "GENERAL",
      "category": "general",
      "description": "Small talk or questions RefundWise does not handle. Replies politely and never routes to tools.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "capabilities": [],
      "riskClass": "low",
      "surfaces": [
        "chat",
        "email",
        "api"
      ],
      "roles": [
        "*"
      ],
      "examples": [
        "hello",
        "thanks for your help",
        "who am I talking to?",
        "what is the weather like today?"
      ],
      "version": 1
    },
    {
      "id": "refund.request",
      "category": "refund",
      "description": "Customer asks for their money back on an order: damaged or defective item, change of mind, or wrong item sent.",
      "parameters": {
        "type": "object",
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "reason_type": {
            "enum": [
              "defective",
              "changed_mind",
              "wrong_item",
              "not_received",
              "other"
            ],
            "default": "other"
          }
        }
      },
      "x-bind": {
        "order_id": {
          "regex": "\\b(ORD-\\d{3,})\\b",
          "upper": true
        },
        "reason_type": {
          "map": {
            "defective": [
              "broken",
              "damaged",
              "defective",
              "faulty",
              "doesn't work",
              "does not work",
              "won't turn on",
              "stopped working",
              "coming off",
              "torn",
              "cracked",
              "not working"
            ],
            "wrong_item": [
              "wrong item",
              "wrong size",
              "wrong colour",
              "wrong color",
              "different item",
              "not what i ordered"
            ],
            "changed_mind": [
              "don't like",
              "dont like",
              "don't need",
              "dont need",
              "changed my mind",
              "doesn't fit",
              "doesnt fit",
              "don't want",
              "no longer need",
              "not needed anymore"
            ]
          }
        }
      },
      "triggers": [
        {
          "phrase": "refund",
          "weight": 0.9
        },
        {
          "phrase": "money back",
          "weight": 0.9
        },
        {
          "phrase": "return it",
          "weight": 0.5
        },
        {
          "phrase": "send it back",
          "weight": 0.5
        },
        {
          "phrase": "stopped working",
          "weight": 0.35
        },
        {
          "phrase": "arrived broken",
          "weight": 0.35
        },
        {
          "phrase": "dont need",
          "weight": 0.55
        },
        {
          "phrase": "no longer need",
          "weight": 0.55
        },
        {
          "phrase": "dont want",
          "weight": 0.5
        },
        {
          "phrase": "changed mind",
          "weight": 0.6
        },
        {
          "phrase": "doesnt fit",
          "weight": 0.5
        },
        {
          "phrase": "wrong size",
          "weight": 0.5
        }
      ],
      "negativeTriggers": [
        "policy",
        "how many days",
        "how long"
      ],
      "capabilities": [
        "order.lookup",
        "refund.history",
        "policy.lookup",
        "policy.check",
        "agent.review",
        "reply.compose"
      ],
      "riskClass": "medium",
      "surfaces": [
        "chat",
        "email",
        "api"
      ],
      "roles": [
        "customer",
        "support-agent",
        "admin"
      ],
      "examples": [
        "I want a refund for order ORD-2001, it arrived broken",
        "Can I get my money back for ORD-2002? I changed my mind",
        "Please refund ORD-2003, you sent me the wrong size",
        "The blender I bought stopped working and I would like a refund"
      ],
      "version": 1
    },
    {
      "id": "order.not-received",
      "category": "order",
      "description": "Customer says an order never arrived or is long overdue and wants it resolved (refund or replacement).",
