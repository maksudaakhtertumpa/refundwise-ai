# Copy to .env and fill in your own values. Never commit .env.

# Meterless Nightshift (local OpenAI-compatible runtime)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# Zetaris local platform
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-token

# true = read the CSV snapshot in data/ instead of Zetaris
SAMPLE_MODE=false
